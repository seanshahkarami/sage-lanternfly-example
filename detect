#!/bin/bash

set -euo pipefail

# We keep each run self contained in a runs/epochtime directory.
inputs="$PWD/inputs"
outputs="$PWD/runs/$(date -u +%s)"
mkdir -p "${outputs}"

# 1. Create candidate crops using YOLO.
yolo predict model=yoloe-26x-seg.pt conf=0.05 imgsz=1280 agnostic_nms=True iou=0.5 classes="insect, bug, black insect with white spots, red and black insect, spotted lanternfly" source=${inputs} project=${outputs} name=yolo save_crop=True exist_ok=True

# 2. Refine YOLO crops using BioCLIP.
bioclip predict --k 1 ${outputs}/yolo/crops/*/*.jpg > ${outputs}/bioclip-results.csv

# 3. Show crops in order of score.
duckdb -c "
select file_name, score
from '${outputs}/bioclip-results.csv'
where species = 'Lycorma delicatula'
order by score desc;
"
